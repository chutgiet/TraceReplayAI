# Environment
NODE_ENV=development

# Database
DATABASE_URL=postgresql://tracereplay:tracereplay@localhost:5432/tracereplay
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001
API_HOST=0.0.0.0

# Auth (placeholder — replace with real values)
JWT_SECRET=change-me-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Logging
LOG_LEVEL=debugchore: scaffold monorepo workspace with AI agent context
LOG_FORMAT=json

# Ingestion
MAX_PAYLOAD_SIZE_KB=512
RATE_LIMIT_PER_MINUTE=1000

# LLM — Local Ollama (DeepSeek R1 for model-based features)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:14b
OLLAMA_TIMEOUT_MS=30000

# Feature flags
ENABLE_REDACTION=true
ENABLE_POLICY_ENGINE=false
