{
  "name": "@tracereplay/ingest-api",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP API service for ingesting agent telemetry into TraceReplay AI",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tracereplay/event-schema": "workspace:*",
    "@tracereplay/common": "workspace:*",
    "fastify": "^5.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
