{
  "name": "@tracereplay/ollama-processor",
  "version": "0.1.0",
  "private": true,
  "description": "Background post-processing service using Ollama (DeepSeek) for run summarization, anomaly detection, and compliance scanning",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tracereplay/event-schema": "workspace:*",
    "@tracereplay/common": "workspace:*",
    "bullmq": "^5.0.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
